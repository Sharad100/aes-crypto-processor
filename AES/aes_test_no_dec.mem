// AES-128: encrypt all-zeros plaintext with all-zeros key
// Expected ciphertext in vr0: 66E94BD4EF8A2C3B884CFA59CA342B2E
// AES-128: encrypt all-zeros plaintext with 0xECE3 key
// Expected ciphertext in vr0: 44a5 something something
// vr0=state  vr1=temp(receives K0)  vr2=current round key
// Format:one 32-bit binary value = 1 instruction per line

// --- Setup ---
00101000110000001110110011100011  // addi v/r3, v0, 0xECE3
00000000000000000000000000000000
00000000000000000000000000000000

// --- AES Setup ---
11100000010001100000000000000000  // akx vr1, vr3  (expand key; key_bank[0..10] loaded)
11101000100000000000000000000000  // lrk vr2, 0    (vr2 = key_bank[0])
10000000000000000010000000000000  // ake vr0,vr0,vr2 (initial AddRoundKey)

// --- Round 1 ---
11101000100000000001000000000000  // lrk vr2, 1
10001000000000000000000000000000  // asb vr0, vr0
10010000000000000000000000000000  // asr vr0, vr0
10011000000000000000000000000000  // amc vr0, vr0
10000000000000000010000000000000  // ake vr0, vr0, vr2

// --- Round 2 ---
11101000100000000010000000000000  // lrk vr2, 2
10001000000000000000000000000000
10010000000000000000000000000000
10011000000000000000000000000000
10000000000000000010000000000000

